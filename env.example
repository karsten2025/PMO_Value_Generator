# ============================================
# PMO Impact Cycle - Environment Variables
# ============================================
# 
# WICHTIG: Kopiere diese Datei zu ".env" und fülle die Werte aus!
# NIEMALS die echte .env Datei in Git committen!
#
# ============================================

# ==========================================
# 🗄️ SUPABASE CONFIGURATION
# ==========================================
# Zu finden in: Supabase Dashboard > Settings > API

# Supabase Project URL (z.B. https://abcdefgh.supabase.co)
SUPABASE_URL=your_supabase_url_here

# Supabase Anon/Public Key (für Python-Scripts)
SUPABASE_KEY=your_supabase_anon_key_here

# ODER: Service Role Key (für Admin-Operationen - GEHEIM!)
# SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ==========================================
# 📝 HINWEISE
# ==========================================
# 
# 1. Für das Frontend: Kopiere diese Variablen auch nach frontend/.env.local
#    (dort mit NEXT_PUBLIC_ Prefix für Client-Side-Zugriff)
#
# 2. Für Python-Scripts: Verwende entweder SUPABASE_KEY (Anon) oder 
#    SUPABASE_SERVICE_KEY (Admin)
#
# 3. Service Role Key: Hat Admin-Rechte! Nur für Backend-Scripts verwenden!
#    NIEMALS im Frontend verwenden oder öffentlich machen!
#
# ==========================================




